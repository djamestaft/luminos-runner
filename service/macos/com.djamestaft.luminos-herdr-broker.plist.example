<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.djamestaft.luminos-herdr-broker</string>
  <key>ProgramArguments</key><array><string>/path/to/node</string><string>/path/to/luminos-runner/dist/hostBrokerMain.js</string><string>--config</string><string>/path/to/protected/luminos-broker.env</string></array>
  <key>WorkingDirectory</key><string>/path/to/luminos-runner</string>
  <key>RunAtLoad</key><false/><key>KeepAlive</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/path/to/protected/broker.log</string>
  <key>StandardErrorPath</key><string>/path/to/protected/broker-error.log</string>
</dict></plist>
