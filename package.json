  },
  "dependencies": {
    "convex": "^1.41.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.7",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
