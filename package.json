{
  "name": "luminos-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/hostBrokerMain.js",
    "legacy:start": "node --enable-source-maps dist/index.js",
    "broker:start": "node --enable-source-maps dist/hostBrokerMain.js",
    "broker:command": "node --enable-source-maps dist/brokerCommandMain.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js scripts/*.test.mjs",
    "services:check": "node scripts/validate-service-templates.mjs"
  },
  "dependencies": {
    "@djamestaft/hermes-herdr-contracts": "file:vendor/hermes-herdr-contracts",
    "convex": "^1.41.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.7",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
