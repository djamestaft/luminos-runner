# Host-local protected broker policy. Install outside the repository with mode
# 0600 (or a Windows ACL limited to the broker account) and pass via --config.
BROKER_PROJECTS_FILE=/absolute/path/to/protected/broker-projects.json
BROKER_GITHUB_TOKEN_FILE=/absolute/path/to/protected/github-token
BROKER_STATE_ROOT=
BROKER_AGENT_KIND=codex
BROKER_SHELL_ZDOTDIR=/path/to/luminos-runner/service/macos/runner-shell
