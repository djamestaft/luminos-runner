# Host-local protected broker policy. Install outside the repository with mode
# 0600 (or a Windows ACL limited to the broker account) and pass via --config.
BROKER_PROJECT_KEY=lmns
BROKER_REPO_ROOT=
BROKER_WORKTREE_ROOT=
BROKER_EXPECTED_REMOTE_URL=
BROKER_GITHUB_REPO=organization/repository
BROKER_GIT_REMOTE=origin
BROKER_BASE_REF=origin/main
BROKER_BASE_BRANCH=main
BROKER_PROFILES=default
BROKER_STATE_ROOT=
BROKER_AGENT_KIND=codex
BROKER_SHELL_ZDOTDIR=/path/to/luminos-runner/service/macos/runner-shell
